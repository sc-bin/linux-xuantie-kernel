#include "k230.dtsi"
#include "display-st7701-480x800.dtsi"
#include <dt-bindings/input/input.h>

/
{
	model = "Canaan CanMV-K230";
	compatible = "canaan,canmv-k230", "canaan,kendryte-k230","k230_canmv_01studio";

	aliases {
		serial3 = &uart3;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		mmc0 = &mmc_sd0;
		mmc1 = &mmc_sd1;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	ddr: memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	sound {
		status                      = "okay";
		compatible                  = "canaan,k230-audio-inno";
		canaan,model                = "K230_I2S_INNO";
		canaan,k230-i2s-controller  = <&i2s>;
		canaan,k230-audio-codec     = <&inno_codec>;
	};

	// User button (GPIO21)
	btn {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio21_pins>;
		status = "disabled";

		btn0: btn0 {
			label = "btn";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpio0_ports 21 GPIO_ACTIVE_LOW>;
		};
	};

	// User LED (GPIO52)
	led {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio52_pins>;
		status = "disabled";

		led0: led0 {
			label = "led";
			gpios = <&gpio1_ports 20 GPIO_ACTIVE_HIGH>;
		};
	};
};

&uart0 {
	status = "okay";
};
&uart1 {
	status = "okay";
};
&uart3 {
	status = "okay";
};
&mmc_sd0{
	status = "okay";
	no-1-8-v;
	cap-sd-highspeed;
	rx_delay_line = <0x0d>;
	tx_delay_line = <0xb0>;
	clocks = <&sd0_cclk_gate>,<&sd0_cclk_gate>;
	clock-names = "core", "bus";
};
&mmc_sd1{
	status = "okay";
	no-1-8-v;
	cap-sd-highspeed;
	mshc_ctrl_r = <0x00>;
};
&usb0 {
	status = "okay";
};
&usb1 {
	dr_mode = "host";
	status = "okay";
};


&i2c4
{
	status = "okay";
};



&vo {
	vth_line = <10>;
};
&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

/* CSI2 default single-cam; CSI0/CSI1 prewritten disabled.
 *   slot0 / mipi.0 = physical CSI2 (ON)
 *   slot1 / mipi.1 = physical CSI0 (disabled; set status="okay" to enable)
 *   slot2 / mipi.2 = physical CSI1 (disabled; set status="okay" to enable)
 * Sensor count = continuous (devN-sensor-name AND mipi.N okay).
 * Enable corresponding &i2cX when enabling a slot.
 */
&mipi0 {
	/* CSI2 -> logical slot0 */
	id = <2>;
	reg = <0x0 0x9000a800 0x0 0x800>;
	interrupts = <121 IRQ_TYPE_LEVEL_HIGH>;
	resets = <&sysctl_reset K230_RESET_CSI2_REG_OFFSET K230_RESET_CSI2_TYPE
			  K230_RESET_CSI2_DONE_BIT K230_RESET_CSI2_ASSERT_BIT>,
		 <&sysctl_reset K230_RESET_M2_REG_OFFSET K230_RESET_M2_TYPE
			  K230_RESET_M2_DONE_BIT K230_RESET_M2_ASSERT_BIT>;
	reset-gpios = <&gpio0_ports 9 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&mipi1 {
	/* CSI0 -> logical slot1; disabled by default */
	id = <0>;
	reg = <0x0 0x90009800 0x0 0x800>;
	interrupts = <115 IRQ_TYPE_LEVEL_HIGH>;
	resets = <&sysctl_reset K230_RESET_CSI0_REG_OFFSET K230_RESET_CSI0_TYPE
			  K230_RESET_CSI0_DONE_BIT K230_RESET_CSI0_ASSERT_BIT>,
		 <&sysctl_reset K230_RESET_M0_REG_OFFSET K230_RESET_M0_TYPE
			  K230_RESET_M0_DONE_BIT K230_RESET_M0_ASSERT_BIT>;
	reset-gpios = <&gpio1_ports 30 GPIO_ACTIVE_HIGH>;
	status = "disabled";
};

&mipi2 {
	/* CSI1 -> logical slot2; disabled by default */
	id = <1>;
	reg = <0x0 0x9000a000 0x0 0x800>;
	interrupts = <118 IRQ_TYPE_LEVEL_HIGH>;
	resets = <&sysctl_reset K230_RESET_CSI1_REG_OFFSET K230_RESET_CSI1_TYPE
			  K230_RESET_CSI1_DONE_BIT K230_RESET_CSI1_ASSERT_BIT>,
		 <&sysctl_reset K230_RESET_M1_REG_OFFSET K230_RESET_M1_TYPE
			  K230_RESET_M1_DONE_BIT K230_RESET_M1_ASSERT_BIT>;
	reset-gpios = <&gpio1_ports 12 GPIO_ACTIVE_HIGH>;
	status = "disabled";
};

&v4l2isp {
	/*
	 * Pre-write three sensors; only enabled mipi.N slots count.
	 * With mipi1/mipi2 disabled: 1 cam / 3 video nodes.
	 */
	dev0-sensor-name = "gc2093";
	dev0-sensor-mode = <0>;
	dev0-sensor-i2c-bus = <4>; /* CSI2 */
	dev1-sensor-name = "gc2093";
	dev1-sensor-mode = <0>;
	dev1-sensor-i2c-bus = <0>; /* CSI0 */
	dev2-sensor-name = "gc2093";
	dev2-sensor-mode = <0>;
	dev2-sensor-i2c-bus = <1>; /* CSI1 */
};
&i2c3
{
	status = "okay";

	touchscreen@38
	{
		compatible = "edt,edt-ft5306";
		reg = <0x38>;
		reset-gpios = <&gpio0_ports 22 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio0_ports>;
		interrupts = <23 IRQ_TYPE_EDGE_FALLING>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <800>;
	};
};

&lcd
{
	// dsi_reset-gpios = <&gpio0_ports 24 GPIO_ACTIVE_HIGH>;
	// backlight_gpio-gpios = <&gpio0_ports 25 GPIO_ACTIVE_HIGH>;
};

&iomux {
	pwm2_pins: pwm2_pins {
        pins = K230_IO46; //io46
        function = K230_IO46_PWM2;  // alt2
    };
	pwm3_pins: pwm3_pins {
		pins = K230_IO47; //io47
		function = K230_IO47_PWM3;
	};
	gpio21_pins: gpio21_pins {
		pins = K230_IO21;
		function = "alt0";
	};
	gpio52_pins: gpio52_pins {
		pins = K230_IO52;
		function = "alt0";
	};
	ospi_pins: ospi_pins {
		pin_clk_mo_mi{
			pins = K230_IO15,K230_IO16,K230_IO17;
        	function = "alt1";
		};
		pin_cs{
			pins = K230_IO14;
        	function = "alt1";
			bias-pull-up;
		};
    };
	i2c2_pins: i2c2_pins {
        pins = K230_IO11,K230_IO12;
        function = "alt3";
		bias-pull-up;
    };
};
&pwm0_2{
	status = "okay";
	pinctrl-names = "default";
    pinctrl-0 = <&pwm2_pins>;
};
&pwm3_5{
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pwm3_pins>;
};
&spi0
{
	status = "okay";
	pinctrl-names = "default";
    pinctrl-0 = <&ospi_pins>;

	spidev0: spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <4000000>;
		status = "okay";
    };
};

&i2c2{
	status = "okay";
	pinctrl-names = "default";
    pinctrl-0 = <&i2c2_pins>;
};
